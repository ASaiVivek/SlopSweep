{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "eval \"$(slopsweep session new | sed 's/^export //')\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "slopsweep session end && slopsweep run --apply"
          }
        ]
      }
    ]
  }
}
